<Window x:Class="ServerManager.App.CreateServerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ServerManager.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="AC Server Manager — Create server" Width="1080" Height="800" MinWidth="940" MinHeight="680"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg}" Foreground="#EDEFF4"
 FontFamily="Bahnschrift" FontSize="14" TextOptions.TextFormattingMode="Display">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="70" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><local:FileImageConverter x:Key="FileImage"/></Window.Resources>
 <Grid x:Name="WizardRoot" Margin="24" Background="{StaticResource Bg}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{DynamicResource WTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource WSubtitle}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
   <Button Grid.Column="1" Content="✕" Width="38" Height="38" Padding="0" Margin="0" Background="#29212A" Foreground="#FF927E" VerticalAlignment="Top" Click="CancelWizard" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L005}"/>
  </Grid>
  <Border Grid.Row="1" Background="#22262F" CornerRadius="6" Padding="14" Margin="0,0,0,14"><DockPanel><TextBlock x:Name="StepCounter" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontFamily="Consolas"/><TextBlock x:Name="StepCaption" FontWeight="SemiBold"/></DockPanel></Border>
  <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="20">
   <Grid x:Name="StepContainer">
    <ScrollViewer x:Name="BasicsStep" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{DynamicResource WServerName}"/><TextBox x:Name="ServerName" Text="My AC Server"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource WRoot}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource L009}" Click="BrowseRoot" Margin="8,5,0,12"/><TextBox x:Name="ServersPath"/></DockPanel></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource WFolder}"/><TextBox x:Name="FolderName" Text="my-ac-server"/></StackPanel>
     </Grid>
     <TextBlock Text="{DynamicResource WGame}"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource L009}" Click="BrowseGame" Margin="8,5,0,12"/><TextBox x:Name="GamePath"/></DockPanel>
     <TextBlock Text="{DynamicResource WEngine}"/><ComboBox x:Name="SourceMode" SelectionChanged="SourceModeChanged"><ComboBoxItem Content="{DynamicResource WDownload}"/><ComboBoxItem Content="{DynamicResource WLocalFolder}"/><ComboBoxItem Content="{DynamicResource WLocalZip}"/></ComboBox>
     <DockPanel x:Name="SourcePathPanel"><Button DockPanel.Dock="Right" Content="{DynamicResource L009}" Click="BrowseSource" Margin="8,5,0,12"/><TextBox x:Name="SourcePath"/></DockPanel>
     <TextBlock Text="{DynamicResource WSourceHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="TrackStep" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
     <DockPanel><TextBox x:Name="TrackSearch" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{DynamicResource SearchTracksPlaceholder}" TextChanged="TrackSearchChanged"/><ListBox x:Name="Tracks" DisplayMemberPath="Name" SelectionChanged="TrackSelected"/></DockPanel>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><Image x:Name="TrackPreview" Height="185" Stretch="UniformToFill"/><TextBlock x:Name="TrackName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,10"/><TextBlock Text="{DynamicResource WLayout}"/><ComboBox x:Name="Layouts" DisplayMemberPath="Label" SelectionChanged="LayoutSelected"/><TextBlock x:Name="TrackDetails" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource WCustomSpline}" Margin="0,18,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseSpline" Padding="10,5" Margin="6,5,0,12"/><TextBox x:Name="SplinePath" FontSize="12"/></DockPanel><TextBlock Text="{DynamicResource WTrackHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,18,0,0"/></StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="CarsStep" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel><TextBox x:Name="CarSearch" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{DynamicResource SearchCarsPlaceholder}" TextChanged="CarSearchChanged"/>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><ComboBox x:Name="CarSkin" DisplayMemberPath="Name"/><Button Content="{DynamicResource WAddCar}" Click="AddCar" Background="#B44C36" Margin="0"/></StackPanel>
      <ListBox x:Name="Cars" SelectionChanged="CarSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel>
     <DockPanel Grid.Column="2"><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock x:Name="SlotCount" Foreground="{StaticResource Accent}"/><TextBlock Text="{DynamicResource WSlotsHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/><Button Content="{DynamicResource WRemoveCar}" Click="RemoveCar" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
      <DataGrid x:Name="ChosenCars" AutoGenerateColumns="False" SelectionMode="Single" CanUserSortColumns="False" CellEditEnding="CarsEdited" RowHeight="56">
       <DataGrid.Columns><DataGridTextColumn x:Name="ModelColumn" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
        <DataGridTextColumn x:Name="SkinColumn" Width="110" Binding="{Binding Skin}" IsReadOnly="True"/>
        <DataGridTextColumn x:Name="QuantityColumn" Width="104" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTemplateColumn x:Name="RoleColumn" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="8,6" FontSize="12"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Grid>
    <ScrollViewer x:Name="SettingsStep" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{DynamicResource WPractice}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="{DynamicResource WTime}"/><TextBox x:Name="StartTime" Text="18:00" Width="180" HorizontalAlignment="Left"/>
     <TextBlock Text="{DynamicResource WJoinPassword}"/><PasswordBox x:Name="JoinPassword"/>
     <TextBlock Text="{DynamicResource WAdminPassword}"/><PasswordBox x:Name="AdminPassword"/><TextBlock Text="{DynamicResource WAdminHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="TCP"/><TextBox x:Name="TcpPort" Text="9600"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="UDP"/><TextBox x:Name="UdpPort" Text="9600"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="HTTP"/><TextBox x:Name="HttpPort" Text="8081"/></StackPanel>
     </Grid>
     <TextBlock Text="{DynamicResource WPortsHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     <CheckBox x:Name="WeatherFx" Content="{DynamicResource WWeather}"/><CheckBox x:Name="Lobby" Content="{DynamicResource WLobby}"/>
     <TextBlock Text="{DynamicResource WLobbyHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ReviewStep" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{DynamicResource WReviewTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ReviewText" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,18"/><Border Background="#22262F" CornerRadius="6" Padding="16"><TextBlock Text="{DynamicResource WReviewHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"/></Border></StackPanel></ScrollViewer>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#FFB29F"/><ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/></StackPanel>
  <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="{DynamicResource L143}" Click="CancelWizard" HorizontalAlignment="Left"/><Button x:Name="BackButton" Grid.Column="1" Content="{DynamicResource WBack}" Click="Previous"/><Button x:Name="NextButton" Grid.Column="2" Content="{DynamicResource WNext}" Click="Next" Background="#B44C36" Margin="0" MinWidth="130"/></Grid>
 </Grid>
</Window>
