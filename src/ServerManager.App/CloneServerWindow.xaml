<Window x:Class="ServerManager.App.CloneServerWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Width="720" Height="690" MinWidth="640" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="#EDEFF4" FontFamily="Bahnschrift" FontSize="14" Closing="CloneClosing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="✕" Width="38" Height="38" Padding="0" Margin="12,0,0,0" Click="CancelClone" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><TextBlock Text="{DynamicResource CloneTitle}" FontSize="26" FontWeight="SemiBold"/></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CloneFields">
   <TextBlock x:Name="SourceCaption" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <TextBlock Text="{DynamicResource WServerName}"/><TextBox x:Name="ServerName" Margin="0,5,0,14"/>
   <TextBlock Text="{DynamicResource WFolder}"/><TextBox x:Name="FolderName" Margin="0,5,0,14"/>
   <TextBlock Text="{DynamicResource CloneDestination}"/><TextBlock x:Name="DestinationRoot" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TCP"/><TextBox x:Name="TcpPort"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="UDP"/><TextBox x:Name="UdpPort"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="HTTP"/><TextBox x:Name="HttpPort"/></StackPanel></Grid>
   <CheckBox x:Name="Advanced" Content="{DynamicResource CloneAdvanced}" Margin="0,8,0,8"/>
   <TextBlock Text="{DynamicResource CloneAdvancedHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>
   <Border Background="{StaticResource Panel}" Padding="14" CornerRadius="8"><TextBlock Text="{DynamicResource CloneHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="CloneMessage" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"/><ProgressBar x:Name="CloneProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,0,0,12" Foreground="{StaticResource Accent}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource L143}" Click="CancelClone"/><Button x:Name="CopyButton" Content="{DynamicResource CloneTitle}" Click="CopyServer" Style="{StaticResource AccentButton}" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</Window>
