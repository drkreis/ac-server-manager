<Window x:Class="ServerManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ServerManager.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="AssettoServer Manager" Width="1360" Height="920" MinWidth="1080" MinHeight="750" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="#EDEFF4" FontFamily="Bahnschrift" FontSize="14" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
