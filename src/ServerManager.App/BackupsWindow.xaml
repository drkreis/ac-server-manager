<Window x:Class="ServerManager.App.BackupsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Width="1160" Height="810" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="#EDEFF4" FontFamily="Bahnschrift" FontSize="14" TextOptions.TextFormattingMode="Display" Closing="BackupClosing" PreviewKeyDown="BackupKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="72" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="✕" Width="38" Height="38" VerticalAlignment="Top" Padding="0" Margin="16,0,0,0" Click="CloseBackups" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel><TextBlock Text="{DynamicResource BackupsTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ServerCaption" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="↻" Padding="10,3" Margin="8,0,0,0" Click="ReloadBackups"/><TextBlock Text="{DynamicResource BackupHistory}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
    <ListBox x:Name="BackupList" Grid.Row="1" SelectionChanged="BackupSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReasonLabel}" Foreground="{Binding Color}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="BackupSummary" Text="{DynamicResource BackupChoose}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="IncludeContent" Content="{DynamicResource BackupIncludeContent}" IsChecked="False" Margin="0,12,0,12" Click="ContentChanged"/></StackPanel>
    <DataGrid x:Name="BackupFiles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="FileSelected" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource BackupFile}" Binding="{Binding RelativePath}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding RelativePath}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="{DynamicResource BackupSizes}" Binding="{Binding Sizes}" Width="175"/><DataGridTextColumn Header="{DynamicResource BackupAction}" Binding="{Binding StateLabel}" Width="220"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" Text="{DynamicResource BackupPreviewPrivacy}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,10"/>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel><TextBlock DockPanel.Dock="Top" Text="{DynamicResource BackupCurrent}" Margin="0,0,0,7"/><TextBox x:Name="CurrentFilePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></DockPanel>
     <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="{DynamicResource BackupSelectedVersion}" Margin="0,0,0,7"/><TextBox x:Name="StoredFilePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></DockPanel>
    </Grid>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BackupStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource BackupOpenFolder}" Click="OpenBackupFolder"/><Button x:Name="RestoreButton" Content="{DynamicResource BackupRestore}" Background="{StaticResource Accent}" IsEnabled="False" Click="RestoreSelected" Margin="0"/></StackPanel></Grid>
  <Border x:Name="BackupBusy" Grid.RowSpan="3" Background="#B3101216" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"><ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource Accent}"/><TextBlock x:Name="BusyMessage" Text="{DynamicResource BackupWorking}" TextWrapping="Wrap" Margin="0,16,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
 </Grid>
</Window>
